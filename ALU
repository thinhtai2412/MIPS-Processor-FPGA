module ALU (A, B, S, Q);

  input [2:0] S;
  input [15:0] A, B;
  output logic [15:0] Q;

  always_comb begin
    case (S)
     3'b000: Q=16'b0;
     3'b001: Q= A+B;
     3'b010: Q= A-B;
     3'b011: Q=A;
     3'b100: Q=A^B;
     3'b101: Q=A|B;
     3'b110: Q=A&B;
     3'b111: Q=A+1;
    endcase
  end
endmodule


module ALU_tb;
 logic [2:0] S;
 logic [15:0] A, B;
 logic [15:0] Q;
 
  ALU DUT (A, B, S, Q);

